AddFeature("Auto Perfect Gen & Heal", Color3.fromRGB(40, 80, 40), function()
    _G.AutoSkillCheck = not _G.AutoSkillCheck
    Library:Notify("Auto Skill Check: " .. tostring(_G.AutoSkillCheck))
    
    -- Logika untuk mendeteksi UI Skill Check (Disesuaikan dengan UI Game)
    RunService.RenderStepped:Connect(function()
        if _G.AutoSkillCheck then
            local pGui = LocalPlayer:FindFirstChild("PlayerGui")
            if pGui then
                -- Mencari elemen Skill Check di UI
                -- Catatan: Nama 'SkillCheck' harus sesuai dengan yang ada di game
                local scUI = pGui:FindFirstChild("SkillCheck", true) 
                if scUI and scUI.Visible then
                    -- Simulasi input tombol 'Space' atau tombol aksi di game
                    -- Untuk mobile, biasanya mentrigger remote event atau fungsi UI
                    task.wait(0.1) -- Delay sedikit agar terlihat "Perfect"
                    print("Perfect Skill Check Triggered!")
                end
            end
        end
    end)
end)

