-- Nama Script: RenndndQ (Mobile Version Only)
-- Mengecek apakah perangkat adalah Mobile
local UserInputService = game:GetService("UserInputService")
local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

if not isMobile then
    game.Players.LocalPlayer:Kick("Skrip RenndndQ ini hanya khusus untuk perangkat Mobile!")
    return
end

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
local Window = Library.CreateLib("RenndndQ - Mobile Edition", "GrapeTheme")

-- [ TOMBOL MELAYANG UNTUK MOBILE ]
local ScreenGui = Instance.new("ScreenGui")
local ToggleButton = Instance.new("TextButton")

ScreenGui.Name = "RenndndQ_MobileToggle"
ScreenGui.Parent = game.CoreGui
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

ToggleButton.Name = "ToggleButton"
ToggleButton.Parent = ScreenGui
ToggleButton.BackgroundColor3 = Color3.fromRGB(120, 0, 150) -- Warna Ungu
ToggleButton.Position = UDim2.new(0.1, 0, 0.15, 0)
ToggleButton.Size = UDim2.new(0, 50, 0, 50)
ToggleButton.Text = "R"
ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleButton.TextSize = 24
ToggleButton.Draggable = true -- Agar tombol bisa digeser di layar HP

-- Fungsi Buka/Tutup saat Tombol di Klik
ToggleButton.MouseButton1Click:Connect(function()
    Library:ToggleUI()
end)

-- Menambahkan lengkungan pada tombol (UI Corner)
local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 10)
UICorner.Parent = ToggleButton

-- [ FITUR SKRIP ]
local MainTab = Window:NewTab("Features")
local MainSection = MainTab:NewSection("Violence District Mods")

MainSection:NewToggle("Auto Parry", "Menangkis Otomatis", function(state)
    _G.AutoParry = state
end)

MainSection:NewButton("Instant Repair", "Interaksi Instan (Gen/Door)", function()
    for _, v in pairs(game.Workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            v.HoldDuration = 0
        end
    end
end)

local VisualTab = Window:NewTab("Visuals")
local VisualSection = VisualTab:NewSection("ESP & Brightness")

VisualSection:NewButton("Full Bright", "Map Terang", function()
    game:GetService("Lighting").Brightness = 2
    game:GetService("Lighting").ClockTime = 14
    game:GetService("Lighting").GlobalShadows = false
end)

VisualSection:NewButton("Highlight All", "Lihat Musuh/Teman", function()
    for _, v in pairs(game.Players:GetPlayers()) do
        if v ~= game.Players.LocalPlayer and v.Character then
            local hl = Instance.new("Highlight", v.Character)
            hl.FillColor = Color3.fromRGB(255, 0, 0)
        end
    end
end)

local MiscTab = Window:NewTab("Misc")
local MiscSection = MiscTab:NewSection("Movement")

MiscSection:NewSlider("WalkSpeed", "Lari Cepat", 100, 16, function(s)
    game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = s
end)

-- Notifikasi
Library:Notify("RenndndQ Mobile", "Gunakan tombol 'R' di layar untuk menu", 5)

