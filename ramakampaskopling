--[[
    DYRON MODE V1 - ADVANCED COMBAT SUITE
    Features: ESP (Name, Dist, Highlight), Full Bright, Hitbox (1-25), Auto Parry
]]

local DyronV1 = {
    Settings = {
        ESP = {Names = true, Distance = true, Highlight = true},
        HitboxSize = 15, -- Atur antara 1 - 25
        AutoParryRange = 15,
        FullBright = true
    }
}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

--// FUNCTION: FULL BRIGHT (NIGHT VISION)
if DyronV1.Settings.FullBright then
    Lighting.Brightness = 2
    Lighting.ClockTime = 14
    Lighting.FogEnd = 100000
    Lighting.GlobalShadows = false
    Lighting:GetPropertyChangedSignal("ClockTime"):Connect(function()
        Lighting.ClockTime = 14
    end)
end

--// FUNCTION: ESP & HITBOX EXPANDER
local function ApplyEnhancements(v)
    if v ~= LocalPlayer then
        local function Update()
            local char = v.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                -- Hitbox Expander
                local hrp = char.HumanoidRootPart
                hrp.Size = Vector3.new(DyronV1.Settings.HitboxSize, DyronV1.Settings.HitboxSize, DyronV1.Settings.HitboxSize)
                hrp.Transparency = 0.7
                hrp.BrickColor = BrickColor.new("Really red")
                hrp.CanCollide = false

                -- Highlight
                if DyronV1.Settings.ESP.Highlight and not char:FindFirstChild("Dyron_High") then
                    local hl = Instance.new("Highlight", char)
                    hl.Name = "Dyron_High"
                    hl.FillTransparency = 0.5
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                end

                -- Name & Distance (BillboardGui)
                if not char:FindFirstChild("Dyron_Tag") then
                    local bg = Instance.new("BillboardGui", char)
                    bg.Name = "Dyron_Tag"
                    bg.AlwaysOnTop = true
                    bg.Size = UDim2.new(0, 200, 0, 50)
                    bg.ExtentsOffset = Vector3.new(0, 3, 0)
                    
                    local tl = Instance.new("TextLabel", bg)
                    tl.Size = UDim2.new(1, 0, 1, 0)
                    tl.BackgroundTransparency = 1
                    tl.TextColor3 = Color3.fromRGB(255, 255, 255)
                    tl.TextStrokeTransparency = 0
                    tl.TextSize = 14

                    RunService.RenderStepped:Connect(function()
                        if char:FindFirstChild("HumanoidRootPart") then
                            local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - char.HumanoidRootPart.Position).Magnitude)
                            tl.Text = string.format("%s\n[%sm]", v.Name, dist)
                        end
                    end)
                end
            end
        end
        v.CharacterAdded:Connect(Update)
        if v.Character then Update() end
    end
end

--// FUNCTION: AUTO PARRY (LOGIC)
-- Catatan: Mengasumsikan mekanisme 'Parry' dipicu oleh RemoteEvent atau KeyCode 'F'
local function AttemptParry()
    for _, enemy in pairs(Players:GetPlayers()) do
        if enemy ~= LocalPlayer and enemy.Character and enemy.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (LocalPlayer.Character.HumanoidRootPart.Position - enemy.Character.HumanoidRootPart.Position).Magnitude
            if dist <= DyronV1.Settings.AutoParryRange then
                -- Menstimulasi input 'F' untuk Parry
                game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.F, false, game)
                wait(0.1)
                game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.F, false, game)
            end
        end
    end
end

--// CORE LOOP
RunService.PostSimulation:Connect(function()
    AttemptParry()
end)

for _, p in pairs(Players:GetPlayers()) do ApplyEnhancements(p) end
Players.PlayerAdded:Connect(ApplyEnhancements)

print("DYRON MODE V1: ALL SYSTEMS OPERATIONAL")

